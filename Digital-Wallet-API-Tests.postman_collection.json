                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Fund Wallet - Invalid Wallet ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "50",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/invalid-id/fund",
              "host": ["{{base_url}}"],
              "path": ["invalid-id", "fund"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 or 500\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([404, 500]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Wallet Transfer Tests",
      "item": [
        {
          "name": "Transfer Funds - Valid Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
