                  "key": "fromWalletId",
                  "value": "{{wallet_id_1}}",
                  "type": "text"
                },
                {
                  "key": "toWalletId",
                  "value": "{{wallet_id_2}}",
                  "type": "text"
                },
                {
                  "key": "amount",
                  "value": "25.00",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/transfer",
              "host": ["{{base_url}}"],
              "path": ["transfer"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message', 'Transfer completed successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
