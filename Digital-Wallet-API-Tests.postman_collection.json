        }
      ]
    },
    {
      "name": "Wallet Funding Tests",
      "item": [
        {
          "name": "Fund Wallet - Valid Amount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "100.50",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/{{wallet_id_1}}/fund",
              "host": ["{{base_url}}"],
              "path": ["{{wallet_id_1}}", "fund"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has transaction details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('amount', '100.50');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Fund Wallet - Zero Amount",
          "request": {
            "method": "POST",
            "header": [
